// Dev container for BoogaBooster - see openspec/changes/add-dev-container/design.md.
// Works unchanged in local VS Code Dev Containers and in GitHub Codespaces.
{
  "name": "BoogaBooster",
  "image": "mcr.microsoft.com/devcontainers/dotnet:10.0",

  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    },
    // Its own Docker engine rather than the host's: daprd runs as a process inside this
    // container and reaches RabbitMQ on localhost:5672, which only works when the port is
    // published by an engine running in here (design D2). The feature mounts a volume on
    // /var/lib/docker, so pulled images survive container rebuilds.
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    // Pinned: "latest" is resolved through the unauthenticated GitHub API and fails when
    // that is rate-limited, leaving an empty version.
    "ghcr.io/dapr/cli/dapr-cli:0": {
      "version": "1.18.2"
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },

  "remoteEnv": {
    // Global .NET tools - the 4dotnet-csharp-style-guide MCP server is launched by bare name.
    "PATH": "${containerEnv:PATH}:/home/vscode/.dotnet/tools"
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "remoteUser": "vscode"
}
